{
  "name": "strapi-plugin-cron-lock",
  "version": "1.0.0",
  "description": "Distributed lock for Strapi 5 cron jobs. Prevents duplicate execution when running multiple instances.",
  "license": "MIT",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "cron",
    "scheduler",
    "lock",
    "distributed-lock",
    "redis",
    "horizontal-scaling",
    "kubernetes"
  ],
  "homepage": "https://github.com/amoramishvili/strapi-plugin-cron-lock#readme",
  "bugs": {
    "url": "https://github.com/amoramishvili/strapi-plugin-cron-lock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoramishvili/strapi-plugin-cron-lock.git"
  },
  "author": {
    "name": "Amo"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/types": "^5.0.0",
    "@types/node": "^20.19.43",
    "ioredis": "^5.4.1",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "strapi": {
    "kind": "plugin",
    "name": "cron-lock",
    "displayName": "Cron Lock",
    "description": "Prevents duplicate cron execution across multiple Strapi instances"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
